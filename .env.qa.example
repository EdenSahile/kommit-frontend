# Modèle de .env.qa, lu par `pnpm test:e2e:qa` : tests e2e sur l'URL déployée en DEV.
# URL du backend à consommer, déployé en DEV.
VITE_API_URL=https://kommit-backend-<prénom>-dev.onrender.com

# URL du frontend à tester, déployé en DEV.
# Sans "/" final : QA_BASE_URL sert aussi d'Origin.
QA_BASE_URL=https://kommit-frontend-<prénom>-dev.vercel.app

# URL de la base Neon de DEV. Sans elle, SM-19 de e2e/signout.test.ts est sauté.
# Elle sert aussi à supprimer les comptes de test : le backend n'a pas de route dédiée aujourd'hui.
E2E_DATABASE_URL=
